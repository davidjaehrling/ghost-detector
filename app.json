{
  "expo": {
    "name": "Ghost Detector",
    "slug": "ghost-detector",
    "scheme": "ghostdetector",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Camera access required for capture. Frames stay on this device.",
          "recordAudioAndroid": false
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "delayAppMeasurementInit": true
        }
      ]
    ],
    "android": {
      "package": "com.ghostdetector.app",
      "permissions": [
        "android.permission.HIGH_SAMPLING_RATE_SENSORS"
      ]
    },
    "web": {
      "output": "static",
      "bundler": "metro"
    }
  }
}
