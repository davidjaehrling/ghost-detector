{
  "name": "ghost-detector",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "web": "node scripts/copy-canvaskit.mjs && expo start --web",
    "web:export": "node scripts/copy-canvaskit.mjs && expo export --platform web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:copy": "node scripts/lint-copy.mjs",
    "eas-build-pre-install": "node scripts/check-ad-ids.mjs",
    "check:ad-ids": "node scripts/check-ad-ids.mjs",
    "test": "vitest run",
    "smoke": "pnpm typecheck && pnpm lint && pnpm lint:copy && pnpm check:ad-ids && pnpm test",
    "e2e:web": "pnpm web:export && playwright test",
    "e2e:web:update": "pnpm web:export && playwright test --update-snapshots"
  },
  "dependencies": {
    "@expo-google-fonts/b612-mono": "^0.4.1",
    "@expo-google-fonts/vt323": "^0.4.1",
    "@expo/metro-runtime": "~57.0.16",
    "@shopify/react-native-skia": "2.14.0",
    "expo": "~57.0.28",
    "expo-asset": "~57.0.19",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.20",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image-manipulator": "~57.0.21",
    "expo-linking": "~57.0.12",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.26",
    "expo-sensors": "~57.0.3",
    "expo-sharing": "~57.0.23",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "jpeg-js": "^0.4.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-audio-api": "0.13.6",
    "react-native-google-mobile-ads": "17.2.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@playwright/test": "1.56.1",
    "@types/react": "~19.2.18",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4"
  },
  "packageManager": "pnpm@10.28.0"
}
