{
  "name": "ghost-detector",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "web": "expo start --web",
    "web:export": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:copy": "node scripts/lint-copy.mjs",
    "test": "vitest run",
    "smoke": "pnpm typecheck && pnpm lint && pnpm lint:copy && pnpm test",
    "e2e:web": "pnpm web:export && playwright test",
    "e2e:web:update": "pnpm web:export && playwright test --update-snapshots"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "expo": "~57.0.28",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.20",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.26",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/react": "~19.2.18",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4"
  },
  "packageManager": "pnpm@10.28.0"
}
