{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ghost Detector feature contract",
  "type": "object",
  "required": ["features"],
  "properties": {
    "rules": { "type": "string" },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "phase", "description", "acceptance", "evidence", "passes"],
        "properties": {
          "id": { "type": "string", "pattern": "^P[0-9]+-[0-9]{2}$" },
          "phase": { "type": "string", "pattern": "^P[0-9]+$" },
          "description": { "type": "string" },
          "acceptance": { "type": "string" },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["kind", "ref"],
              "properties": {
                "kind": { "enum": ["command", "screenshot", "video", "artifact"] },
                "ref": { "type": "string", "description": "Command line or repo path" },
                "output": { "type": "string", "description": "Trimmed command output" },
                "by": { "type": "string", "description": "Agent role that produced it" },
                "date": { "type": "string" }
              }
            }
          },
          "passes": { "type": "boolean" },
          "refuter": { "type": "string", "description": "Refuter verdict reference in PROGRESS or the PR" },
          "blocked_by": { "type": "string" }
        }
      }
    }
  }
}
